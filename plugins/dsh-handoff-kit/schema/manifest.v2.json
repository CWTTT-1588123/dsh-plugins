{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dsh-handoff-kit handoff manifest (schemaVersion 2)",
  "description": "Machine record of one handoff batch, as written by dsh-handoff-kit 1.0. Writers of schemaVersion 2 emit only these documented keys; readers must preserve unrecognized keys for forward compatibility. See spec/HANDOFF.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "generator",
    "batchId",
    "createdAt",
    "project",
    "session",
    "sandbox",
    "inputs",
    "git",
    "artifacts",
    "files",
    "sessionTrace",
    "redactions",
    "warnings",
    "limits",
    "scan"
  ],
  "properties": {
    "schema": { "const": "dsh-handoff-kit/handoff" },
    "schemaVersion": { "const": 2 },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "dshVersion", "platform"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "dshVersion": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 }
      }
    },
    "batchId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "workspace"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "workspace": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cwd", "agentPreset"],
      "properties": {
        "id": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "cwd": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "agentPreset": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "workspaceRoot"],
      "properties": {
        "mode": {
          "oneOf": [
            { "type": "string", "enum": ["read-only", "workspace-write", "danger-full-access"] },
            { "type": "null" }
          ]
        },
        "workspaceRoot": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "goal",
        "summary",
        "decisions",
        "nextSteps",
        "concepts",
        "flow",
        "risks",
        "files",
        "copyFiles"
      ],
      "properties": {
        "title": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "goal": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "summary": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "decisions": { "type": "array", "items": { "type": "string" } },
        "nextSteps": { "type": "array", "items": { "type": "string" } },
        "concepts": { "type": "array", "items": { "type": "string" } },
        "flow": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "files": { "type": "array", "items": { "type": "string" } },
        "copyFiles": { "type": "boolean" }
      }
    },
    "git": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["head", "branch", "detached", "remote", "lastCommit", "indexVersion", "packedRefsPresent", "reflog"],
          "properties": {
            "head": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
            "branch": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
            "detached": { "type": "boolean" },
            "remote": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
            "lastCommit": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sha", "time", "subject"],
                  "properties": {
                    "sha": { "type": "string", "minLength": 7 },
                    "time": { "type": "string" },
                    "subject": { "type": "string" }
                  }
                }
              ]
            },
            "indexVersion": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
            "packedRefsPresent": { "type": "boolean" },
            "reflog": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sha", "time", "subject"],
                "properties": {
                  "sha": { "type": "string" },
                  "time": { "type": "string" },
                  "subject": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["entry", "config", "test", "doc", "source", "other"] },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": {
            "oneOf": [
              { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              { "type": "string", "const": "" }
            ]
          },
          "truncated": { "type": "boolean" },
          "skippedReason": { "type": "string" }
        }
      }
    },
    "sessionTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "eventCounts", "toolCalls", "touchedFiles", "commands", "window"],
      "properties": {
        "sessionId": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "eventCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "toolCalls", "toolErrors"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "toolCalls": { "type": "integer", "minimum": 0 },
            "toolErrors": { "type": "integer", "minimum": 0 }
          }
        },
        "toolCalls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "byName"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "byName": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "touchedFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "tool", "count", "lastSeq"],
            "properties": {
              "path": { "type": "string" },
              "tool": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 },
              "lastSeq": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool", "commandRedacted", "lastSeq"],
            "properties": {
              "tool": { "type": "string" },
              "commandRedacted": { "type": "string" },
              "lastSeq": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["events", "truncated"],
          "properties": {
            "events": { "type": "integer", "minimum": 0 },
            "truncated": { "type": "boolean" }
          }
        }
      }
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "kind", "count"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "detail"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxEntries", "maxDepth", "maxHashFiles", "maxFileBytes", "maxTotalBytes", "maxSessionEvents", "maxCommandChars"],
      "properties": {
        "maxEntries": { "type": "integer", "minimum": 0 },
        "maxDepth": { "type": "integer", "minimum": 0 },
        "maxHashFiles": { "type": "integer", "minimum": 0 },
        "maxFileBytes": { "type": "integer", "minimum": 0 },
        "maxTotalBytes": { "type": "integer", "minimum": 0 },
        "maxSessionEvents": { "type": "integer", "minimum": 0 },
        "maxCommandChars": { "type": "integer", "minimum": 0 }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "dirs", "denied", "symlinksSkipped", "readBytes", "explicitFiles", "tree"],
      "properties": {
        "entries": { "type": "integer", "minimum": 0 },
        "dirs": { "type": "integer", "minimum": 0 },
        "denied": { "type": "integer", "minimum": 0 },
        "symlinksSkipped": { "type": "integer", "minimum": 0 },
        "readBytes": { "type": "integer", "minimum": 0 },
        "explicitFiles": { "type": "array", "items": { "type": "string" } },
        "tree": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["file", "directory", "other"] },
              "bytes": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "source": { "type": "string" },
        "turn": { "type": "integer", "minimum": 0 },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "added", "deleted", "binary", "oversized"],
          "properties": {
            "files": { "type": "integer", "minimum": 0 },
            "added": { "type": "integer", "minimum": 0 },
            "deleted": { "type": "integer", "minimum": 0 },
            "binary": { "type": "integer", "minimum": 0 },
            "oversized": { "type": "integer", "minimum": 0 }
          }
        },
        "truncated": { "type": "boolean" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "added", "deleted"],
            "properties": {
              "path": { "type": "string" },
              "added": { "type": "integer", "minimum": 0 },
              "deleted": { "type": "integer", "minimum": 0 },
              "binary": { "type": "boolean" },
              "oversized": { "type": "boolean" }
            }
          }
        },
        "diffs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind"],
            "properties": {
              "path": { "type": "string" },
              "kind": { "type": "string" },
              "truncated": { "type": "boolean" },
              "hunks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["oldStart", "oldLines", "newStart", "newLines", "lines"],
                  "properties": {
                    "oldStart": { "type": "integer", "minimum": 0 },
                    "oldLines": { "type": "integer", "minimum": 0 },
                    "newStart": { "type": "integer", "minimum": 0 },
                    "newLines": { "type": "integer", "minimum": 0 },
                    "lines": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        },
        "currentTurn": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "turn": { "type": "integer", "minimum": 0 },
            "note": { "type": "string" },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "tool", "count", "lastSeq"],
                "properties": {
                  "path": { "type": "string" },
                  "tool": { "type": "string" },
                  "count": { "type": "integer", "minimum": 0 },
                  "lastSeq": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        "collectedAt": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "fuel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available"],
          "properties": {
            "available": { "type": "boolean" },
            "note": { "type": "string" },
            "goal": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "objective", "phase", "roundsStarted", "maxGoalRounds", "updatedAt"],
              "properties": {
                "id": { "type": "string" },
                "objective": { "type": "string" },
                "phase": { "type": "string" },
                "roundsStarted": { "type": "integer", "minimum": 0 },
                "maxGoalRounds": { "type": "integer", "minimum": 0 },
                "activation": { "type": "string" },
                "updatedAt": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "jobs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "count", "statusCounts", "items"],
          "properties": {
            "available": { "type": "boolean" },
            "count": { "type": "integer", "minimum": 0 },
            "note": { "type": "string" },
            "statusCounts": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind", "label", "status", "startedAt"],
                "properties": {
                  "id": { "type": "string" },
                  "kind": { "type": "string" },
                  "label": { "type": "string" },
                  "status": { "type": "string" },
                  "startedAt": { "type": "integer", "minimum": 0 },
                  "finishedAt": { "type": "integer", "minimum": 0 },
                  "progress": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "previous", "root"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 2 },
        "previous": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$" },
        "root": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$" },
        "supersedes": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$" }
      }
    },
    "target": { "type": "string", "enum": ["user", "workspace"] }
  }
}
