{
  "name": "dsh-handoff-kit",
  "version": "1.0.0",
  "description": "Deterministic session handoff packages (HANDOFF.md + manifest.json) for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CWTTT-1588123/dsh-plugins.git",
    "directory": "plugins/dsh-handoff-kit"
  },
  "homepage": "https://github.com/CWTTT-1588123/dsh-plugins/tree/main/plugins/dsh-handoff-kit#readme",
  "bugs": {
    "url": "https://github.com/CWTTT-1588123/dsh-plugins/issues"
  },
  "bin": {
    "handoff-kit": "./bin/handoff-kit.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "bin",
    "src",
    "spec",
    "schema",
    "skills",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "USAGE.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=20"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
